@Panel Background{
  size_type: fill
  color: #111111

  @Panel{
    position_type: anchor
    anchor: center
    parent_anchor: center
    size: 200, 200
    color: #222222

    @Panel{
      position_type: anchor
      position: 2, 2
      size_type: percent
      size: 0.485, 0.485
      color: #77FF77
    }

    @Panel{
      position_type: anchor
      anchor: topRight
      parent_anchor: topRight
      position: -2, 2
      size_type: percent
      size: 0.485, 0.485
      color: #FFFF77
    }

    @Panel{
      position_type: anchor
      anchor: bottomLeft
      parent_anchor: bottomLeft
      position: 2, -2
      size_type: percent
      size: 0.485, 0.485
      color: #77FFFF
    }

    @Panel{
      position_type: anchor
      anchor: bottomRight
      parent_anchor: bottomRight
      position: -2, -2
      size_type: percent
      size: 0.485, 0.485
      color: #FF7777
    }

  }
}
