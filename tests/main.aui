@Panel background{
  animatable: true
  color: rgb(5, 5, 5)
  size_type: fill
  
  @Panel{
    animatable: true
    smoothing: 10
    size: 200, 200
    position_type: anchor
    anchor: center
    parent_anchor: center
    position: 0, 0

    @Panel{
      position_type: anchor
      anchor: topLeft
      parent_anchor: topLeft
      size_type: percent
      position: 2, 2

      size: 0.5, 0.5
    }

    color: rgb(30, 30, 30)
  }

}
